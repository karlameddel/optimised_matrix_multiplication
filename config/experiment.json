{
  "seed": 42,
  "cpus": [2, 4, 6, 8],
  "limits": { "time_s": 300, "mem_bytes": 4294967296, "costly_s": 30 },
  "java": { "xmx": "4g", "reps": 5, "warmup": 3, "warmup_min_ms": 300, "target_ms": 20 },
  "dense": {
    "sizes": [100, 200, 500, 1000, 2000, 4000],
    "methods": ["ijk", "ikj", "blocked"],
    "block": 64,
    "block_sweep": { "n": 1000, "sizes": [16, 32, 64, 128, 256] },
    "controls": [
      { "name": "no_superword", "jvm_flags": ["-XX:-UseSuperWord"], "methods": ["ikj", "blocked"], "sizes": [1000, 2000] }
    ]
  },
  "sparse": {
    "density_sweep": { "n": 2000, "densities": [0.001, 0.005, 0.01, 0.05, 0.1] },
    "size_sweep": { "density": 0.01, "sizes": [500, 1000, 2000, 4000] },
    "dense_reference_methods": ["ikj"]
  }
}
